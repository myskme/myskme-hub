  "facades": [
    {
      "file": "facades/gothic.svg",
      "source": "FACADES",
      "id": "gothic",
      "name": "哥特尖券",
      "era": "12 世纪 · 法兰西岛",
      "department": "lobby",
      "fact": "飞扶壁把屋顶的侧推力传到墙外，墙才敢被掏空成整面彩窗——结构先松手，采光才有位置。",
      "line": "大堂挑高十二米，据说是为了让人一进门就觉得自己很小。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "b697d30600a7f5c01e575a8cd0accf0b569735d76084d4393166c41d6e0d28f7"
    },
    {
      "file": "facades/classical.svg",
      "source": "FACADES",
      "id": "classical",
      "name": "古典柱式",
      "era": "公元前 5 世纪 · 雅典",
      "department": "quality",
      "fact": "柱式先定比例再谈装饰：柱径决定柱高、柱高决定开间，一栋楼的所有尺寸都从一个数长出来。",
      "line": "质检科认为比例即合规。不合比例的，先按不合规处理。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "e033e3149c604d8eb1d22d591c023bc7d78084a8d405a3b1bc06b0c297dd8b0c"
    },
    {
      "file": "facades/deco.svg",
      "source": "FACADES",
      "id": "deco",
      "name": "装饰艺术退台",
      "era": "1916 年 · 纽约",
      "department": "fax",
      "fact": "纽约 1916 年区划法规定楼越高越要往里收，否则街道见不到天——今天的摩天楼轮廓是采光法规画出来的。",
      "line": "传真科因此获得了一个不通风的三角形角落，并以此为荣。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "afe5e8760ffca2051c146d138aa286cd95f7222e0e14d130f25ca5bccfb77c7f"
    },
    {
      "file": "facades/curtain.svg",
      "source": "FACADES",
      "id": "curtain",
      "name": "现代幕墙",
      "era": "1951 年 · 芝加哥",
      "department": "rent",
      "fact": "结构与围护分家之后，墙不再承重，于是可以整面做成玻璃——「自由立面」是把承重任务交给柱子换来的。",
      "line": "房租科据此认为，既然墙不承重，就该由租户承重。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "2eb1d81684075f35590a408764431fe1c9ed4ab04c52b33f7e30b4707a10649d"
    },
    {
      "file": "facades/brutal.svg",
      "source": "FACADES",
      "id": "brutal",
      "name": "粗野主义",
      "era": "1950 年代 · 马赛",
      "department": "monkey",
      "fact": "béton brut 就是「生混凝土」：拆模后不再修饰，连木纹与气泡都留着——把施工过程当成饰面。",
      "line": "驯猴办喜欢这种墙。它说这种墙不掩饰任何事，猴子也别想掩饰。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "cd6dbedf46c2b12509d340eab8b751fc997dbeb445602a866a6d45036f7c3b50"
    },
    {
      "file": "facades/islamic.svg",
      "source": "FACADES",
      "id": "islamic",
      "name": "伊斯兰几何",
      "era": "14 世纪 · 格拉纳达",
      "department": "redundancy",
      "fact": "一套有限的作图规则（等分圆周、连线、再等分）能生成永不重复的镶嵌——图案的复杂来自规则的重复，不来自设计者的即兴。",
      "line": "冗余科对此极为认同：规则重复得越多，越显得部门必要。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "3910c27f33537c2128791062d7f39f07a173c58a118e0871146aeb6ae6374272"
    },
    {
      "file": "facades/shoji.svg",
      "source": "FACADES",
      "id": "shoji",
      "name": "日式格子",
      "era": "室町时代 · 京都",
      "department": "fertilizer",
      "fact": "房间尺寸由一张榻榻米反推：先定模数，再定房间，最后定房子——尺寸链是从人身上开始算的。",
      "line": "黑化肥科表示，它们的模数是一袋。一切按袋计算，包括加班。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "4f53eb406c72ce68a93545446350bed619907b0298c3537c8c878cf78a3b77e3"
    },
    {
      "file": "facades/dougong.svg",
      "source": "FACADES",
      "id": "dougong",
      "name": "中式斗拱",
      "era": "唐代 · 五台山",
      "department": "puzzle",
      "fact": "斗与拱层层出跳，把屋檐一步步挑出去，全靠榫卯咬合不用一根钉——悬挑不是靠强度，是靠层数。",
      "line": "谜题科认为这正是它的工作方式：一层一层出跳，谁也说不清挑出去多远。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "ae03504ff3dda2317cce3da5b09d9c8d3ad21e618ec18f4bc310e272175baa71"
    },
    {
      "file": "facades/hightech.svg",
      "source": "FACADES",
      "id": "hightech",
      "name": "高技派",
      "era": "1977 年 · 巴黎",
      "department": "tongue",
      "fact": "把结构与管线全翻到外立面上，内部才能空出一整层无柱空间——外面越乱，里面越自由。",
      "line": "绕口令办的管线也在外面。它说这样念错了容易查。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "322fa803bdaef8a9360ae437e9f603eebc9416de64ac5ead42cc16bbd3cd8728"
    },
    {
      "file": "facades/catenary.svg",
      "source": "FACADES",
      "id": "catenary",
      "name": "悬链线拱",
      "era": "1900 年代 · 巴塞罗那",
      "department": "observation",
      "fact": "把链子倒挂，它自然垂成的曲线翻过来就是最省力的拱——形状不是画出来的，是称出来的。",
      "line": "观景台把这条挂在墙上，作为「不要硬撑」的官方依据。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "95f86fe25ec3afc7910329eafde7b896811993a129c543765c388aab74fd23f7"
    },
    {
      "file": "facades/prairie.svg",
      "source": "FACADES",
      "id": "prairie",
      "name": "草原式",
      "era": "1910 年 · 芝加哥郊外",
      "department": "punctuation",
      "fact": "把屋檐压低挑远、让横线一路拉长，房子就显得贴着地面——用水平线抵消高度，是刻意的反纪念性。",
      "line": "标点科很喜欢横线。它们认为句号也是一种把话压下去的方式。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "c3f878ea84019739d68652bb81ddb5eb731de9245bf6eb7569e009e1bc4959b8"
    },
    {
      "file": "facades/parametric.svg",
      "source": "FACADES",
      "id": "parametric",
      "name": "参数化表皮",
      "era": "21 世纪 · 全球",
      "department": "construction",
      "fact": "表皮的每一格由算法按受力与日照算出来，所以每一格都不一样——设计的对象从「形状」变成了「生成形状的规则」。",
      "line": "加盖工程部因此宣布：楼层数也由规则生成，恕不提前公布。",
      "viewBox": "60 -6 270 270",
      "width": 270,
      "height": 270,
      "sha256": "2efaca0551516074581eb227cf209d758c3c32da6516fb434c149f4a852011a4"
    }
  ],
